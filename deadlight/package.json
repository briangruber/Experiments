{
  "name": "deadlight",
  "private": true,
  "type": "module",
  "description": "A WebGPU jump-scare game whose every mesh is generated by Tripo.",
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "generate": "node tools/generate.mjs",
    "optimize": "node tools/optimize.mjs",
    "assets": "node tools/generate.mjs && node tools/optimize.mjs && node tools/verify-rig.mjs assets/creature.glb",
    "serve": "node tools/serve.mjs",
    "shot": "node tools/shot.mjs",
    "verify": "node tools/verify-rig.mjs --all"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "playwright": "^1.49.0",
    "sharp": "^0.33.0",
    "three": "0.185.1"
  }
}
